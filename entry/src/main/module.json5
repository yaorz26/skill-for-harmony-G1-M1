      },
      {
        "name": "yaorz26-g1m1-text-length-20261107",
        "abilityName": "EntryAbility",
        "version": "1.0.0",
        "srcEntries": ["../../skills/yaorz26-g1m1-text-length-20261107/scripts/TextLengthSkill.ets"]
      }
    ]
  }
}
